# ==================================================
# Stage 1: Build & Vendor Dependencies
# ==================================================
FROM php:8.4-fpm-bookworm AS builder

# 1.1 ติดตั้ง System Dependencies สำหรับการ Compiling
RUN apt-get update && apt-get install -y \
    wget \
    unzip \
    git \
    && rm -rf /var/lib/apt/lists/*

# 1.2 ติดตั้ง Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# 1.3 คัดลอกเฉพาะไฟล์ Dependency เพื่อใช้ประโยชน์จาก Docker Layer Caching
WORKDIR /var/www/contact
COPY composer.json composer.lock ./

# 1.4 ติดตั้ง Dependencies เฉพาะ Production (ใส่ --ignore-platform-reqs ป้องกัน error เช็ก oci8)
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --ignore-platform-reqs

# 1.5 คัดลอก Source Code ทั้งหมด และ Optimize Autoloader
COPY . .
RUN composer dump-autoload --optimize --no-dev --classmap-authoritative --ignore-platform-reqs

# ==================================================
# Stage 2: Final Production Runtime Image
# ==================================================
FROM php:8.4-fpm-bookworm

# 2.1 ติดตั้ง System Runtime Dependencies
RUN apt-get update && apt-get install -y \
    wget \
    unzip \
    libaio1 \
    libaio-dev \
    git \
    || apt-get install -y libaio1t64 libaio-dev \
    && rm -rf /var/lib/apt/lists/*

# 2.2 ติดตั้ง Oracle Instant Client 21 (v21.15)
WORKDIR /opt/oracle
RUN wget https://download.oracle.com/otn_software/linux/instantclient/2115000/instantclient-basic-linux.x64-21.15.0.0.0dbru.zip && \
    wget https://download.oracle.com/otn_software/linux/instantclient/2115000/instantclient-sdk-linux.x64-21.15.0.0.0dbru.zip && \
    unzip instantclient-basic-linux.x64-21.15.0.0.0dbru.zip && \
    unzip instantclient-sdk-linux.x64-21.15.0.0.0dbru.zip && \
    rm -f *.zip

RUN ln -s /opt/oracle/instantclient_21_15 /opt/oracle/instantclient && \
    echo /opt/oracle/instantclient > /etc/ld.so.conf.d/oracle-instantclient.conf && \
    ldconfig

ENV LD_LIBRARY_PATH="/opt/oracle/instantclient"
ENV ORACLE_HOME="/opt/oracle/instantclient"

# 2.3 ติดตั้ง PHP Extensions สำหรับ Production (รวม oci8 และ pdo_oci)
ADD https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/
RUN chmod +x /usr/local/bin/install-php-extensions && \
    install-php-extensions bcmath opcache zip intl mbstring oci8 pdo_oci

# 2.4 จัดการ UID/GID (1000:1000) สำหรับ www-data ให้สอดคล้องกับ Docker Host
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN usermod -u ${USER_ID} www-data && groupmod -g ${GROUP_ID} www-data

# 2.5 คัดลอก Application & Vendor จาก Builder Stage
WORKDIR /var/www/contact
COPY --from=builder --chown=www-data:www-data /var/www/contact /var/www/contact

# 2.6 สร้างและตั้งค่า Permission โฟลเดอร์ storage, cache, tmp และ .composer
RUN mkdir -p /var/www/.composer \
            storage \
            bootstrap/cache \
            /tmp/php_tmp && \
    chown -R www-data:www-data /var/www/.composer /var/www/contact /tmp/php_tmp && \
    chmod -R 775 storage bootstrap/cache /tmp/php_tmp

# 2.7 ปรับแต่ง PHP INI สำหรับ Production (OPcache Production Hardening)
RUN echo "upload_max_filesize=100M" > /usr/local/etc/php/conf.d/uploads.ini && \
    echo "post_max_size=100M" >> /usr/local/etc/php/conf.d/uploads.ini && \
    echo "sys_temp_dir=/tmp/php_tmp" >> /usr/local/etc/php/conf.d/uploads.ini && \
    echo "upload_tmp_dir=/tmp/php_tmp" >> /usr/local/etc/php/conf.d/uploads.ini && \
    echo "opcache.enable=1" >> /usr/local/etc/php/conf.d/opcache-prod.ini && \
    echo "opcache.memory_consumption=256" >> /usr/local/etc/php/conf.d/opcache-prod.ini && \
    echo "opcache.max_accelerated_files=20000" >> /usr/local/etc/php/conf.d/opcache-prod.ini && \
    echo "opcache.validate_timestamps=0" >> /usr/local/etc/php/conf.d/opcache-prod.ini

# Add safe directory exception at system level to survive volume mounts
RUN git config --system --add safe.directory /var/www/contact

USER www-data

EXPOSE 9000
CMD ["php-fpm"]
